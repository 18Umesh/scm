{
  "name": "campus",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:web": "pnpm --filter @campus/web dev",
    "db:setup": "tsx scripts/db-setup.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit && pnpm --filter @campus/web typecheck && pnpm --filter @campus/student typecheck && pnpm --filter @campus/mobile typecheck",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.json && turbo run build --filter=@campus/web --filter=@campus/student",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "demo:code": "tsx scripts/demo-code.ts"
  },
  "pnpm": {
    "overrides": {
      "@typescript-eslint/typescript-estree>minimatch": "^11.0.1"
    }
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.39.2",
    "tsx": "^4.21.0",
    "turbo": "^2.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0"
  }
}
