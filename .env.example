# Copy to .env. Embedded PostgreSQL is for local development only.
# Active local school: Netaji Public School; data directory: .data/netaji-campus.
NODE_ENV=development
DATABASE_MODE=embedded
DATABASE_URL=postgresql://campus_runtime:change-me@localhost:5432/campus
DATABASE_ADMIN_URL=postgresql://postgres:change-me@localhost:5432/campus
PORT=4000
WEB_PORT=3000
STUDENT_PORT=3001
AI_ENABLED=false
# School AI spending caps are stored and configured in school settings.
# Use a secrets manager in production. No providers enabled until contract review.
OPENROUTER_API_KEY=
# Compose only: set generated URL-safe passwords before starting containers.
POSTGRES_PASSWORD=
CAMPUS_DATABASE_PASSWORD=
# Required in production; inject through a secrets manager.
AUTH_ENCRYPTION_KEY=
AUTH_OTP_SECRET=
FIELD_ENCRYPTION_KEY=
REQUIRE_DEVICE_OTP=false
RUN_WORKER=false
# JSON objects keyed by school UUID. Leave empty for local counter payments/demo OTP.
SCHOOL_GATEWAYS={}
SCHOOL_MESSAGING={}
SCHOOL_PUSH={}
DOMAIN_TARGET=schools.campus.app
# Local embedded demo only; ignored for production databases.
ADS_DEMO_MODE=false
ADS_ENABLED=false
ADS_SERVICE_URL=http://127.0.0.1:4100
ADS_DATABASE_URL=
ADS_ADMIN_TOKEN=

# Private parent/staff attachments; persist this directory alongside DB backups.
FILE_DIRECTORY=.data/files
FILE_SCHOOL_QUOTA_BYTES=1073741824
# Production document uploads require an HTTPS scanner returning {"clean":true}.
FILE_SCAN_URL=
FILE_SCAN_TOKEN=

# Post attachments: local for this demo; school-drive or links-only in production.
# With no mode configured, production accepts direct uploads only for a connected school Drive.
POST_ATTACHMENT_STORAGE=local
# Secret JSON keyed by school UUID; each school supplies its own account.
# See docs/POST_ATTACHMENTS.md. Keep OAuth secrets out of branding/browser settings.
SCHOOL_FILE_STORES={}

# Teacher LMS: public curriculum only, OpenRouter free router, no paid fallback
TEACHING_AI_ENABLED=false
